{
  "name": "risks-in-sync-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:reviews": "node --import tsx scripts/check-reviews.ts",
    "preflight:scout-contracts": "node scripts/preflight-scout-contracts.mjs",
    "verify:publication-flow": "node --import tsx scripts/verify-publication-flow.mjs",
    "generate:reviews": "node --import tsx scripts/generate-reviews.ts",
    "predev": "npm run check:reviews && npm run generate:reviews",
    "dev": "vite",
    "build": "npm run check:reviews && npm run generate:reviews && tsc -b && vite build && vite build --ssr src/server.tsx --outDir .prerender --emptyOutDir && node scripts/prerender.mjs && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "marked": "18.0.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
