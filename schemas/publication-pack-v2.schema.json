{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://risksinsync.com/schemas/publication-pack-v2.schema.json",
  "title": "Risks In Sync Publication Pack v2 frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "status",
    "issue",
    "review_period",
    "publication_date",
    "title",
    "dek",
    "summary",
    "author",
    "language",
    "method_version",
    "editorial",
    "cascade",
    "sources",
    "images",
    "assets",
    "editorial_modules"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^year-[1-9][0-9]*-nr-[1-9][0-9]*$" },
    "status": { "enum": ["draft", "ready_for_pr"] },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "number", "label"],
      "properties": {
        "year": { "type": "integer", "minimum": 1 },
        "number": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "review_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "publication_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "dek": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "language": { "const": "en" },
    "method_version": { "type": "string", "minLength": 1 },
    "editorial": { "type": ["string", "null"] },
    "cascade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "subtitle", "steps", "outcome_status", "observed_outcome", "counterfactual_outcome", "evidence_status", "note"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "steps": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
        "outcome_status": { "enum": ["contained", "partially_propagated", "fully_propagated", "ongoing", "uncertain"] },
        "observed_outcome": { "type": "string", "minLength": 1 },
        "counterfactual_outcome": { "type": ["string", "null"] },
        "evidence_status": { "enum": ["REPORTED", "OBSERVED", "INFERRED", "UNKNOWN"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "url", "published_date", "accessed_date", "kind", "verification", "note"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "published_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "accessed_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "kind": { "enum": ["primary", "secondary", "context"] },
          "verification": { "enum": ["verified", "unverified"] },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "role", "alt", "decorative", "credit", "source_url", "rights_basis", "verification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["hero", "inline", "social"] },
          "alt": { "type": "string" },
          "decorative": { "type": "boolean" },
          "label": { "type": ["string", "null"], "maxLength": 48 },
          "caption": { "type": ["string", "null"] },
          "credit": { "type": ["string", "null"] },
          "source_url": { "type": ["string", "null"] },
          "rights_basis": { "type": ["string", "null"] },
          "verification": { "enum": ["cleared", "pending"] }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cover", "homepage_vignette"],
      "properties": {
        "cover": { "$ref": "#/definitions/coverAsset" },
        "homepage_vignette": { "$ref": "#/definitions/homepageVignetteAsset" }
      }
    },
    "editorial_modules": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/editorialNoteModule" },
          { "$ref": "#/definitions/operatorChecklistModule" },
          { "$ref": "#/definitions/decisionLogModule" }
        ]
      }
    }
  },
  "definitions": {
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "alt", "decorative", "credit", "source_url", "rights_basis", "verification"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "decorative": { "type": "boolean" },
        "label": { "type": ["string", "null"], "maxLength": 48 },
        "caption": { "type": ["string", "null"], "maxLength": 140 },
        "credit": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"] },
        "rights_basis": { "type": ["string", "null"] },
        "verification": { "enum": ["cleared", "pending"] }
      }
    },
    "coverAsset": { "$ref": "#/definitions/mediaAsset" },
    "homepageVignetteAsset": {
      "allOf": [
        { "$ref": "#/definitions/mediaAsset" },
        {
          "type": "object",
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 48 },
            "caption": { "type": "string", "minLength": 1, "maxLength": 140 }
          },
          "required": ["label", "caption"]
        }
      ]
    },
    "editorialNoteModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "body"],
      "properties": { "type": { "const": "editorial_note" }, "body": { "type": "string", "minLength": 1, "maxLength": 600 } }
    },
    "operatorChecklistModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "operator_checklist" },
        "items": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["signal", "response"],
            "properties": { "signal": { "type": "string", "minLength": 1, "maxLength": 180 }, "response": { "type": "string", "minLength": 1, "maxLength": 280 } }
          }
        }
      }
    },
    "decisionLogModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entries"],
      "properties": {
        "type": { "const": "decision_log" },
        "entries": {
          "type": "array", "minItems": 1, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["decision", "rationale", "evidence_status"],
            "properties": {
              "decision": { "type": "string", "minLength": 1, "maxLength": 180 },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 280 },
              "evidence_status": { "enum": ["REPORTED", "OBSERVED", "INFERRED", "UNKNOWN"] }
            }
          }
        }
      }
    }
  }
}
